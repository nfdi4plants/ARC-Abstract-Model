{
  "name": "arc-base-model-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotnet run --project build/build.fsproj -- TranspileTS",
    "build:base-model": "dotnet run --project build/build.fsproj -- BuildBaseModelJS",
    "build:sqlite": "dotnet run --project build/build.fsproj -- BuildPolyglotSQLiteJS",
    "build:py": "dotnet run --project build/build.fsproj -- TranspilePy",
    "test:js": "dotnet run --project build/build.fsproj -- RunTestsJS"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "esbuild@0.27.7": true
  }
}
